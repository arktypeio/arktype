{
	"name": "ark",
	"description": "TypeScript's 1:1 validator, optimized from editor to runtime",
	"license": "MIT",
	"funding": "https://github.com/sponsors/arktypeio",
	"author": {
		"name": "David Blass",
		"email": "david@arktype.io",
		"url": "https://arktype.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/arktypeio/arktype.git"
	},
	"type": "module",
	"private": true,
	"scripts": {
		"test": "pnpm testTyped --skipTypes",
		"testTyped": "mocha --exclude \"ark/attest/**/*.test.*\"",
		"testFiles": "mocha --onlyNamedTestFiles --no-package --node-option conditions=ark-ts --require ./ark/repo/mocha.globalSetup.ts --timeout 10000",
		"prChecks": "pnpm lint && pnpm buildRepo && pnpm testRepoWithBenches",
		"attest": "ts ./ark/attest/cli/cli.ts",
		"build": "pnpm -r --filter !\"@ark/docs\" build",
		"buildRepo": "pnpm rmBuild && pnpm build && pnpm buildDocs",
		"buildDocs": "pnpm -r --filter \"@ark/docs\" build",
		"buildCjs": "ARKTYPE_CJS=1 pnpm -r build",
		"rmBuild": "pnpm -r exec rm -rf out",
		"ts": "node ./ark/repo/ts.js",
		"testRepoWithBenches": "pnpm typecheckRepo && pnpm testRepo && pnpm bench && pnpm testTypedLoose && pnpm testTsCompat && pnpm testTsVersions",
		"typecheckRepo": "tsc --incremental",
		"testRepo": "pnpm test && pnpm testV8 && pnpm testBuild && pnpm testNext && pnpm testShadow && pnpm testSkill && pnpm testIntegration && pnpm -r --filter \"@ark/attest\" test",
		"testIntegration": "pnpm -r --filter \"arktype\" testIntegration",
		"testV8": "node --allow-natives-syntax ./ark/repo/testV8.js",
		"testBuild": "node ./ark/repo/testBuild.ts",
		"testSkill": "node ./ark/repo/testSkill.ts",
		"testNext": "node ./ark/repo/testNext.ts",
		"testShadow": "node ./ark/repo/testShadow.ts",
		"testHistory": "node --conditions ark-ts ./ark/repo/testHistory.ts",
		"testEnvironments": "node --conditions ark-ts ./ark/aot/__tests__/testEnvironments.ts",
		"testPrograms": "pnpm testFiles ark/aot/__tests__/testPrograms.ts --skipTypes",
		"writePrecompileSettings": "node --conditions ark-ts ./ark/aot/__tests__/writeSettings.ts",
		"testPerturbation": "node --conditions ark-ts ./ark/aot/__tests__/testPerturbation.ts",
		"testPruneParity": "node --conditions ark-ts ./ark/aot/__tests__/testPruneParity.ts",
		"testAlgebra": "node --conditions ark-ts ./ark/type/__tests__/algebra/testAlgebra.ts",
		"testDifferential": "pnpm test --exclude ark/type/__tests__/gc.test.ts --require ./ark/aot/__tests__/testDifferential.ts",
		"testJitless": "pnpm test --exclude \"ark/aot/**\" --exclude \"ark/docs/components/playground/__tests__/precompile.test.ts\" --grep \"jit by default|has jit|compiled code|deep invalid data through an undiscriminated union\" --invert --require ./ark/repo/testJitless.ts",
		"testCache": "pnpm test --exclude ark/type/__tests__/gc.test.ts --exclude ark/type/__tests__/facts.test.ts --exclude ark/type/__tests__/precompile.test.ts --grep \"^config jitless$|NaN in discriminated unions jitless$|Object.prototype members are undeclared jitless$\" --invert --require ./ark/aot/__tests__/testCache.ts",
		"testTsVersions": "ts ./ark/repo/testTsVersions.ts",
		"testTsCompat": "tsc --project ark/repo/tsCompat && tsc --project ark/repo/tsCompat/tsconfig.loose.json && tsc --project ark/repo/tsCompat/tsconfig.attest.json && tsc --project ark/repo/tsCompat/tsconfig.workers.json && tsc --project ark/repo/tsCompat/tsconfig.meta.json",
		"testTypedLoose": "pnpm testTyped --tsconfig null --compilerOptions \"{ \\\"module\\\": \\\"NodeNext\\\", \\\"moduleResolution\\\": \\\"NodeNext\\\", \\\"strictNullChecks\\\": true, \\\"exactOptionalPropertyTypes\\\": true, \\\"customConditions\\\": [\\\"ark-ts\\\"] }\" --skipInlineInstantiations",
		"bench": "export ATTEST_checker=\"\\\"tsgo\\\"\" ATTEST_benchErrorOnThresholdExceeded=\"\\\"types\\\"\" && pnpm benchOperand &&pnpm benchOperator && pnpm benchNary && pnpm benchObject && pnpm benchMatch && pnpm benchCyclic && pnpm benchJsonSchema",
		"benchUp": "ATTEST_updateSnapshots=1 pnpm bench",
		"benchOperand": "ts ./ark/type/__tests__/operand.bench.ts",
		"benchOperator": "ts ./ark/type/__tests__/operator.bench.ts",
		"benchNary": "ts ./ark/type/__tests__/nary.bench.ts",
		"benchObject": "ts ./ark/type/__tests__/object.bench.ts",
		"benchMatch": "ts ./ark/type/__tests__/match.bench.ts",
		"benchCyclic": "ts ./ark/type/__tests__/cyclic.bench.ts",
		"benchJsonSchema": "ts ./ark/json-schema/__tests__/infer.bench.ts",
		"benchRuntime": "ts ./ark/type/__tests__/runtime.bench.ts --benchErrorOnThresholdExceeded types && ts ./ark/repo/bench/validate.bench.ts --benchErrorOnThresholdExceeded types && ts ./ark/repo/bench/create.bench.ts --benchErrorOnThresholdExceeded types",
		"benchRuntimeUp": "ATTEST_updateSnapshots=1 pnpm benchRuntime",
		"benchImport": "node ./ark/repo/bench/import.ts",
		"benchSize": "node ./ark/repo/bench/size.ts",
		"benchScale": "node ./ark/repo/bench/scale/measure.ts",
		"benchUsage": "node ./ark/repo/bench/usage.ts",
		"benchTypia": "node ./ark/repo/bench/generateTypia.ts",
		"benchValidate": "ts ./ark/repo/bench/validate.ts",
		"benchCount": "ts ./ark/repo/bench/count.ts",
		"benchBuildTime": "node ./ark/repo/bench/buildTime/registered.ts",
		"benchExternal": "node ./ark/repo/bench/external/reproduce.ts",
		"benchScoreboard": "pnpm benchTypia && pnpm benchSize && pnpm benchImport && pnpm benchValidate",
		"benchRegex": "ts ./ark/regex/__tests__/regex.bench.ts",
		"scratch": "ts ./ark/repo/scratch.ts",
		"lint": "pnpm checkPrettier && pnpm checkEslint",
		"checkPrettier": "prettier --ignore-path .gitignore --ignore-path ./ark/repo/.prettierignore --check .",
		"checkEslint": "eslint --max-warnings=0 .",
		"format": "prettier --ignore-path .gitignore --ignore-path ./ark/repo/.prettierignore --write .",
		"knip": "knip",
		"bump": "ts ./ark/repo/bump.ts",
		"ci:publish": "ts ./ark/repo/publish.ts",
		"publishExtension": "cd ark/dark && pnpm publishExtension",
		"upDeps": "pnpm up -r --latest"
	},
	"devDependencies": {
		"@ark/attest": "link:ark/attest",
		"@ark/fs": "workspace:*",
		"@ark/json-schema": "workspace:*",
		"@ark/repo": "workspace:*",
		"@ark/util": "workspace:*",
		"@eslint/js": "9.37.0",
		"@standard-schema/spec": "1.0.0",
		"@types/json-schema": "7.0.15",
		"@types/mocha": "10.0.10",
		"@types/node": "24.7.2",
		"arksets": "workspace:*",
		"c8": "10.1.3",
		"dts-bundle-generator": "9.5.1",
		"eslint": "9.37.0",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-only-warn": "1.1.0",
		"eslint-plugin-prefer-arrow-functions": "3.9.1",
		"eslint-plugin-unicorn": "61.0.2",
		"fast-check": "3.23.2",
		"knip": "5.65.0",
		"mocha": "11.7.4",
		"prettier": "3.6.2",
		"tsup": "8.5.0",
		"typescript": "catalog:",
		"typescript-eslint": "8.46.1"
	},
	"mocha": {
		"//": "IF YOU UPDATE THE MOCHA CONFIG HERE, PLEASE ALSO UPDATE ark/repo/mocha.package.jsonc, the testFiles script AND .vscode/settings.json",
		"spec": [
			"**/__tests__/**/*.test.*"
		],
		"ignore": "**/node_modules/**/*",
		"node-option": [
			"conditions=ark-ts"
		],
		"require": "./ark/repo/mocha.globalSetup.ts",
		"timeout": 10000
	},
	"c8": {
		"checkCoverage": true,
		"lines": 96,
		"src": "./src",
		"exclude": [
			"__tests__/**"
		],
		"extension": ".ts",
		"reporter": "lcovonly"
	},
	"prettier": {
		"useTabs": true,
		"semi": false,
		"trailingComma": "none",
		"experimentalTernaries": true,
		"arrowParens": "avoid"
	},
	"engines": {
		"node": ">=22.18.0",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@10.19.0",
	"pnpm": {
		"overrides": {
			"@ark/attest": "link:ark/attest"
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"typescript": "*",
				"eslint": "*"
			}
		},
		"ignoredBuiltDependencies": [
			"sharp"
		]
	}
}
