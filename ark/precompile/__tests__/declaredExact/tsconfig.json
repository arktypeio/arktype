{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"customConditions": ["ark-ts"],
		"lib": ["ESNext", "DOM"],
		"types": [],
		"rootDir": "src",
		"exactOptionalPropertyTypes": true,
		"outDir": "out"
	},
	"include": ["src"]
}
