{
	"name": "arktype",
	"description": "TypeScript's 1:1 validator, optimized from editor to runtime",
	"version": "2.2.8",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/arktypeio/arktype.git",
		"directory": "ark/type"
	},
	"author": {
		"name": "David Blass",
		"email": "david@arktype.io",
		"url": "https://arktype.io"
	},
	"type": "module",
	"main": "./out/index.js",
	"types": "./out/index.d.ts",
	"exports": {
		".": {
			"ark-ts": "./index.ts",
			"default": "./out/index.js"
		},
		"./codecs": {
			"ark-ts": "./codecs.ts",
			"default": "./out/codecs.js"
		},
		"./config": {
			"ark-ts": "./config.ts",
			"default": "./out/config.js"
		},
		"./i18n": {
			"ark-ts": "./i18n.ts",
			"default": "./out/i18n.js"
		},
		"./locales/de": {
			"ark-ts": "./locales/de.ts",
			"default": "./out/locales/de.js"
		},
		"./locales/en": {
			"ark-ts": "./locales/en.ts",
			"default": "./out/locales/en.js"
		},
		"./internal": {
			"ark-ts": "./internal.ts",
			"default": "./out/internal.js"
		},
		"./internal/config.ts": {
			"ark-ts": "./config.ts",
			"default": "./out/config.js"
		},
		"./internal/config.js": {
			"ark-ts": "./config.ts",
			"default": "./out/config.js"
		},
		"./internal/keywords/ts.ts": {
			"ark-ts": "./keywords/ts.ts",
			"default": "./out/keywords/ts.js"
		},
		"./internal/keywords/ts.js": {
			"ark-ts": "./keywords/ts.ts",
			"default": "./out/keywords/ts.js"
		},
		"./internal/*.ts": {
			"ark-ts": "./*.ts",
			"types": "./out/*.d.ts",
			"default": "./out/internal.js"
		},
		"./internal/*.js": {
			"ark-ts": "./*.ts",
			"types": "./out/*.d.ts",
			"default": "./out/internal.js"
		}
	},
	"files": [
		"out",
		"skills"
	],
	"scripts": {
		"build": "ts ../repo/build.ts",
		"test": "ts ../repo/testPackage.ts; pnpm testIntegration",
		"testIntegration": "pnpm testSimpleConfig && pnpm testAllConfig && pnpm testOnFailConfig && pnpm testEoptConfig && pnpm testJitlessConfig && pnpm testCsp && pnpm testSchemaFirst && pnpm testMissingGlobals && pnpm testLocaleConfig && pnpm testLocaleWithoutIntl",
		"testSimpleConfig": "ts ./__tests__/integration/testSimpleConfig.ts",
		"testAllConfig": "ts ./__tests__/integration/testAllConfig.ts",
		"testOnFailConfig": "ts ./__tests__/integration/testOnFailConfig.ts",
		"testEoptConfig": "ts ./__tests__/integration/testEoptConfig.ts",
		"testJitlessConfig": "ts ./__tests__/integration/testJitlessConfig.ts",
		"testCsp": "ts ./__tests__/integration/testCsp.ts",
		"testSchemaFirst": "ts ./__tests__/integration/testSchemaFirst.ts",
		"testMissingGlobals": "ts ./__tests__/integration/testMissingGlobals.ts",
		"testLocaleConfig": "ts ./__tests__/integration/testLocaleConfig.ts",
		"testLocaleWithoutIntl": "ts ./__tests__/integration/testLocaleWithoutIntl.ts"
	},
	"dependencies": {
		"@ark/util": "workspace:*",
		"@ark/schema": "workspace:*",
		"arkregex": "workspace:*",
		"arksets": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
