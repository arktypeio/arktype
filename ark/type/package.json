{
	"name": "arktype",
	"description": "TypeScript's smallest, fastest validator. One prompt away.",
	"keywords": [
		"typescript",
		"validation",
		"validator",
		"schema",
		"runtime",
		"types",
		"inference",
		"type-safe",
		"parser",
		"standard-schema",
		"json-schema",
		"precompile"
	],
	"version": "3.0.0-rc.6",
	"arkAotVersion": "3.0.0-rc.6",
	"license": "MIT",
	"homepage": "https://arktype.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/arktypeio/arktype.git",
		"directory": "ark/type"
	},
	"author": {
		"name": "David Blass",
		"email": "david@arktype.io",
		"url": "https://arktype.io"
	},
	"type": "module",
	"sideEffects": [
		"./index.ts",
		"./codecs.ts",
		"./config.ts",
		"./errors.ts",
		"./mutatesInput.ts",
		"./i18n.ts",
		"./keywords/phrases.ts",
		"./locales/*.ts",
		"./schema.ts",
		"./schemaInternal.ts",
		"./internal.ts",
		"./island.ts",
		"./islandDependency.ts",
		"./precompiled.ts",
		"./runtime.ts",
		"./runtimeDevelopment.ts",
		"./out/index.js",
		"./out/codecs.js",
		"./out/config.js",
		"./out/errors.js",
		"./out/mutatesInput.js",
		"./out/i18n.js",
		"./out/keywords/phrases.js",
		"./out/locales/*.js",
		"./out/schema.js",
		"./out/schemaInternal.js",
		"./out/internal.js",
		"./out/island.js",
		"./out/islandDependency.js",
		"./out/precompiled.js",
		"./out/runtime.js",
		"./out/runtimeDevelopment.js",
		"./out/chunk-*.js"
	],
	"main": "./out/index.js",
	"types": "./out/index.d.ts",
	"bin": {
		"ark": "out/cli.js"
	},
	"typesVersions": {
		"*": {
			"codecs": [
				"./out/codecs.d.ts"
			],
			"config": [
				"./out/config.d.ts"
			],
			"errors": [
				"./out/errors.d.ts"
			],
			"i18n": [
				"./out/i18n.d.ts"
			],
			"locales/*": [
				"./out/locales/*.d.ts"
			],
			"mutatesInput": [
				"./out/mutatesInput.d.ts"
			],
			"regex": [
				"./out/regex.d.ts"
			],
			"runtime": [
				"./out/runtime.d.ts"
			],
			"schema": [
				"./out/schema.d.ts"
			],
			"schema/internal": [
				"./out/schemaInternal.d.ts"
			],
			"schema/issueFeatures": [
				"./out/shared/issueFeatures.d.ts"
			],
			"schema/runtime": [
				"./out/schemaRuntime.d.ts"
			],
			"schema/runtime/none": [
				"./out/schemaRuntimeNone.d.ts"
			],
			"schema/runtime/none-lean": [
				"./out/schemaRuntimeNoneLean.d.ts"
			],
			"schema/runtime/lean": [
				"./out/schemaRuntimeLean.d.ts"
			],
			"util": [
				"./out/util.d.ts"
			],
			"internal": [
				"./out/internal.d.ts"
			],
			"internal/arktype.js": [
				"./out/index.d.ts"
			],
			"internal/*": [
				"./out/*"
			]
		}
	},
	"exports": {
		".": {
			"ark-ts": "./index.ts",
			"default": "./out/index.js"
		},
		"./codecs": {
			"ark-ts": "./codecs.ts",
			"default": "./out/codecs.js"
		},
		"./config": {
			"ark-ts": "./config.ts",
			"default": "./out/config.js"
		},
		"./errors": {
			"ark-ts": "./errors.ts",
			"default": "./out/errors.js"
		},
		"./i18n": {
			"ark-ts": "./i18n.ts",
			"default": "./out/i18n.js"
		},
		"./locales/de": {
			"ark-ts": "./locales/de.ts",
			"default": "./out/locales/de.js"
		},
		"./locales/en": {
			"ark-ts": "./locales/en.ts",
			"default": "./out/locales/en.js"
		},
		"./mutatesInput": {
			"ark-ts": "./mutatesInput.ts",
			"default": "./out/mutatesInput.js"
		},
		"./regex": {
			"ark-ts": "./regex.ts",
			"default": "./out/regex.js"
		},
		"./runtime": {
			"ark-ts": {
				"development": "./runtimeDevelopment.ts",
				"default": "./runtime.ts"
			},
			"development": "./out/runtimeDevelopment.js",
			"default": "./out/runtime.js"
		},
		"./schema": {
			"ark-ts": "./schema.ts",
			"default": "./out/schema.js"
		},
		"./schema/internal": {
			"ark-ts": "./schemaInternal.ts",
			"default": "./out/schemaInternal.js"
		},
		"./schema/issueFeatures": {
			"ark-ts": "./schemaIssueFeatures.ts",
			"default": "./out/shared/issueFeatures.js"
		},
		"./schema/runtime": {
			"ark-ts": "./schemaRuntime.ts",
			"default": "./out/schemaRuntime.js"
		},
		"./schema/runtime/none": {
			"ark-ts": "./schemaRuntimeNone.ts",
			"default": "./out/schemaRuntimeNone.js"
		},
		"./schema/runtime/none-lean": {
			"ark-ts": "./schemaRuntimeNoneLean.ts",
			"default": "./out/schemaRuntimeNoneLean.js"
		},
		"./schema/runtime/lean": {
			"ark-ts": "./schemaRuntimeLean.ts",
			"default": "./out/schemaRuntimeLean.js"
		},
		"./util": {
			"ark-ts": "./util.ts",
			"default": "./out/util.js"
		},
		"./internal": {
			"ark-ts": "./internal.ts",
			"default": "./out/internal.js"
		},
		"./internal/config.ts": {
			"ark-ts": "./config.ts",
			"default": "./out/config.js"
		},
		"./internal/config.js": {
			"ark-ts": "./config.ts",
			"default": "./out/config.js"
		},
		"./internal/keywords/ts.ts": {
			"ark-ts": "./keywords/ts.ts",
			"default": "./out/keywords/ts.js"
		},
		"./internal/keywords/ts.js": {
			"ark-ts": "./keywords/ts.ts",
			"default": "./out/keywords/ts.js"
		},
		"./internal/precompiled.js": {
			"ark-ts": "./precompiled.ts",
			"default": "./out/precompiled.js"
		},
		"./internal/island.js": {
			"ark-ts": "./island.ts",
			"default": "./out/island.js"
		},
		"./internal/islandDependency.js": {
			"ark-ts": "./islandDependency.ts",
			"default": "./out/islandDependency.js"
		},
		"./internal/arktype.js": {
			"ark-ts": "./index.ts",
			"default": "./out/index.js"
		},
		"./internal/runtime.ts": {
			"ark-ts": "./runtime.ts",
			"default": "./out/runtime.js"
		},
		"./internal/runtime.js": {
			"ark-ts": "./runtime.ts",
			"default": "./out/runtime.js"
		},
		"./internal/runtimeExports.ts": {
			"ark-ts": "./runtimeExports.ts",
			"types": "./out/runtimeExports.d.ts",
			"default": "./out/runtime.js"
		},
		"./internal/runtimeExports.js": {
			"ark-ts": "./runtimeExports.ts",
			"types": "./out/runtimeExports.d.ts",
			"default": "./out/runtime.js"
		},
		"./internal/checkers.ts": {
			"ark-ts": "./checkers.ts",
			"types": "./out/checkers.d.ts",
			"default": "./out/runtime.js"
		},
		"./internal/checkers.js": {
			"ark-ts": "./checkers.ts",
			"types": "./out/checkers.d.ts",
			"default": "./out/runtime.js"
		},
		"./internal/regex.ts": {
			"ark-ts": "./regex.ts",
			"default": "./out/regex.js"
		},
		"./internal/regex.js": {
			"ark-ts": "./regex.ts",
			"default": "./out/regex.js"
		},
		"./internal/schema.ts": {
			"ark-ts": "./schema.ts",
			"default": "./out/schema.js"
		},
		"./internal/schema.js": {
			"ark-ts": "./schema.ts",
			"default": "./out/schema.js"
		},
		"./internal/schemaInternal.ts": {
			"ark-ts": "./schemaInternal.ts",
			"default": "./out/schemaInternal.js"
		},
		"./internal/schemaInternal.js": {
			"ark-ts": "./schemaInternal.ts",
			"default": "./out/schemaInternal.js"
		},
		"./internal/schemaIssueFeatures.ts": {
			"ark-ts": "./schemaIssueFeatures.ts",
			"default": "./out/shared/issueFeatures.js"
		},
		"./internal/schemaIssueFeatures.js": {
			"ark-ts": "./schemaIssueFeatures.ts",
			"default": "./out/shared/issueFeatures.js"
		},
		"./internal/schemaRuntime.ts": {
			"ark-ts": "./schemaRuntime.ts",
			"default": "./out/schemaRuntime.js"
		},
		"./internal/schemaRuntime.js": {
			"ark-ts": "./schemaRuntime.ts",
			"default": "./out/schemaRuntime.js"
		},
		"./internal/schemaRuntimeNone.ts": {
			"ark-ts": "./schemaRuntimeNone.ts",
			"default": "./out/schemaRuntimeNone.js"
		},
		"./internal/schemaRuntimeNone.js": {
			"ark-ts": "./schemaRuntimeNone.ts",
			"default": "./out/schemaRuntimeNone.js"
		},
		"./internal/schemaRuntimeLean.ts": {
			"ark-ts": "./schemaRuntimeLean.ts",
			"default": "./out/schemaRuntimeLean.js"
		},
		"./internal/schemaRuntimeLean.js": {
			"ark-ts": "./schemaRuntimeLean.ts",
			"default": "./out/schemaRuntimeLean.js"
		},
		"./internal/schemaRuntimeNoneLean.ts": {
			"ark-ts": "./schemaRuntimeNoneLean.ts",
			"default": "./out/schemaRuntimeNoneLean.js"
		},
		"./internal/schemaRuntimeNoneLean.js": {
			"ark-ts": "./schemaRuntimeNoneLean.ts",
			"default": "./out/schemaRuntimeNoneLean.js"
		},
		"./internal/util.ts": {
			"ark-ts": "./util.ts",
			"default": "./out/util.js"
		},
		"./internal/util.js": {
			"ark-ts": "./util.ts",
			"default": "./out/util.js"
		},
		"./internal/*.ts": {
			"ark-ts": "./*.ts",
			"types": "./out/*.d.ts",
			"default": "./out/internal.js"
		},
		"./internal/*.js": {
			"ark-ts": "./*.ts",
			"types": "./out/*.d.ts",
			"default": "./out/internal.js"
		}
	},
	"files": [
		"out",
		"skills"
	],
	"scripts": {
		"build": "ts ../repo/build.ts",
		"test": "ts ../repo/testPackage.ts; pnpm testIntegration",
		"testIntegration": "pnpm testSimpleConfig && pnpm testAllConfig && pnpm testOnFailConfig && pnpm testEoptConfig && pnpm testJitlessConfig && pnpm testCsp && pnpm testCspConfiguredAfterImport && pnpm testCspAfterLoad && pnpm testPrecompiled && pnpm testSchemaFirst && pnpm testConfigAfterImport && pnpm testMissingGlobals && pnpm testLocaleConfig && pnpm testLocaleWithoutIntl && pnpm testLocaleWithoutI18n && pnpm testLocaleImportedAfter && pnpm testLocaleNormalizedEarly",
		"testSimpleConfig": "ts ./__tests__/integration/testSimpleConfig.ts",
		"testAllConfig": "ts ./__tests__/integration/testAllConfig.ts",
		"testOnFailConfig": "ts ./__tests__/integration/testOnFailConfig.ts",
		"testEoptConfig": "ts ./__tests__/integration/testEoptConfig.ts",
		"testJitlessConfig": "ts ./__tests__/integration/testJitlessConfig.ts",
		"testCsp": "ts ./__tests__/integration/testCsp.ts",
		"testCspConfiguredAfterImport": "ts ./__tests__/integration/testCspConfiguredAfterImport.ts",
		"testCspAfterLoad": "ts ./__tests__/integration/testCspAfterLoad.ts",
		"testPrecompiled": "ts ./__tests__/integration/testPrecompiled.ts",
		"testSchemaFirst": "ts ./__tests__/integration/testSchemaFirst.ts",
		"testConfigAfterImport": "ts ./__tests__/integration/testConfigAfterImport.ts",
		"testMissingGlobals": "ts ./__tests__/integration/testMissingGlobals.ts",
		"testLocaleConfig": "ts ./__tests__/integration/testLocaleConfig.ts",
		"testLocaleWithoutIntl": "ts ./__tests__/integration/testLocaleWithoutIntl.ts",
		"testLocaleWithoutI18n": "ts ./__tests__/integration/testLocaleWithoutI18n.ts",
		"testLocaleImportedAfter": "ts ./__tests__/integration/testLocaleImportedAfter.ts",
		"testLocaleNormalizedEarly": "ts ./__tests__/integration/testLocaleNormalizedEarly.ts"
	},
	"devDependencies": {
		"@ark/util": "workspace:*",
		"@ark/schema": "workspace:*",
		"arkregex": "workspace:*",
		"arksets": "workspace:*",
		"zod": "4.6.7"
	},
	"publishConfig": {
		"access": "public"
	}
}
