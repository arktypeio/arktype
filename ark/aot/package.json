{
	"name": "@ark/aot",
	"description": "Precompiles arktype definitions when you build, so no parser ships and nothing compiles at runtime",
	"keywords": [
		"arktype",
		"typescript",
		"validation",
		"precompile",
		"aot",
		"vite",
		"rollup",
		"webpack",
		"esbuild",
		"unplugin"
	],
	"version": "3.0.0-beta.2",
	"license": "MIT",
	"author": {
		"name": "David Blass",
		"email": "david@arktype.io",
		"url": "https://arktype.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/arktypeio/arktype.git",
		"directory": "ark/aot"
	},
	"type": "module",
	"main": "./out/index.js",
	"types": "./out/index.d.ts",
	"typesVersions": {
		"*": {
			"eslint": [
				"./out/eslint.d.ts"
			],
			"unplugin": [
				"./out/unplugin.d.ts"
			],
			"bun": [
				"./out/bun.d.ts"
			],
			"node": [
				"./out/node.d.ts"
			],
			"shadow": [
				"./out/shadow.d.ts"
			],
			"turbopack": [
				"./out/turbopack.d.ts"
			],
			"turbopack/runtime": [
				"./out/turbopackRuntime.d.ts"
			],
			"internal/*": [
				"./out/*"
			]
		}
	},
	"exports": {
		".": {
			"ark-ts": "./index.ts",
			"default": "./out/index.js"
		},
		"./eslint": {
			"ark-ts": "./eslint.ts",
			"default": "./out/eslint.js"
		},
		"./unplugin": {
			"ark-ts": "./unplugin.ts",
			"default": "./out/unplugin.js"
		},
		"./bun": {
			"ark-ts": "./bun.ts",
			"default": "./out/bun.js"
		},
		"./node": {
			"ark-ts": "./node.ts",
			"default": "./out/node.js"
		},
		"./shadow": {
			"ark-ts": "./shadow.ts",
			"default": "./out/shadow.js"
		},
		"./turbopack": {
			"ark-ts": "./turbopack.ts",
			"default": "./out/turbopack.js"
		},
		"./turbopack/runtime": {
			"ark-ts": "./turbopackRuntime.ts",
			"default": "./out/turbopackRuntime.js"
		},
		"./package.json": "./package.json",
		"./ark.schema.json": "./ark.schema.json",
		"./internal/*.ts": {
			"ark-ts": "./*.ts",
			"default": "./out/*.js"
		},
		"./internal/*.js": {
			"ark-ts": "./*.ts",
			"default": "./out/*.js"
		}
	},
	"files": [
		"out",
		"ark.schema.json"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"bin": {
		"arktype-precompile": "out/cli.js"
	},
	"scripts": {
		"build": "ts ../repo/build.ts",
		"test": "ts ../repo/testPackage.ts",
		"tnt": "ts ../repo/testPackage.ts --skipTypes"
	},
	"dependencies": {
		"@jridgewell/sourcemap-codec": "1.5.5",
		"magic-string": "0.30.19",
		"oxc-parser": "0.153.0",
		"oxc-resolver": "11.24.2",
		"unplugin": "3.4.0"
	},
	"peerDependencies": {
		"arktype": "workspace:*",
		"eslint": ">=9",
		"tsrs": "*",
		"typescript": ">=5.5"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		},
		"tsrs": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@ark/schema": "workspace:*",
		"@elysiajs/openapi": "1.4.16",
		"@hono/standard-validator": "0.4.0",
		"@hookform/resolvers": "5.9.1",
		"@modelcontextprotocol/client": "2.3.1",
		"@modelcontextprotocol/server": "2.3.1",
		"@orpc/arktype": "1.15.7",
		"@orpc/openapi": "1.15.7",
		"@orpc/server": "1.15.7",
		"@rspack/core": "2.2.9",
		"@standard-schema/spec": "1.0.0",
		"@t3-oss/env-core": "0.13.11",
		"@tanstack/form-core": "1.33.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/router-core": "1.171.39",
		"@trpc/server": "11.19.0",
		"@types/react": "19.3.0",
		"@typescript-eslint/scope-manager": "8.46.1",
		"ai": "7.0.140",
		"arktype": "workspace:*",
		"drizzle-arktype": "0.1.3",
		"drizzle-orm": "0.45.4",
		"elysia": "1.4.30",
		"esbuild": "0.25.10",
		"fast-check": "4.10.2",
		"hono": "4.13.13",
		"react": "19.2.9",
		"react-dom": "19.2.9",
		"react-hook-form": "7.90.0",
		"rollup": "4.52.4",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript-6": "npm:typescript@6.0.3",
		"typescript-7": "npm:typescript@7.1.0-beta",
		"vite": "8.3.4",
		"vitest": "5.0.3",
		"webpack": "5.112.0"
	}
}
