{
	"extends": "./ark/util/tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"customConditions": ["ark-ts"],
		// attest imports TypeScript's classic API (TS 5/6) or tsgo's (TS 7)
		// from whichever is installed, so types for both come from aliases
		"paths": {
			"typescript": [
				"./ark/attest/node_modules/typescript-6/lib/typescript.d.ts"
			],
			"typescript/ast": [
				"./ark/attest/node_modules/typescript-7/dist/ast/index.d.ts"
			],
			"typescript/fs": [
				"./ark/attest/node_modules/typescript-7/dist/api/fs.d.ts"
			],
			"typescript/sync": [
				"./ark/attest/node_modules/typescript-7/dist/api/sync/api.d.ts"
			]
		},
		"types": ["mocha", "node"],
		// avoid prototype methods that are not available and cannot easily be transpiled
		"lib": ["ES2020"]
		// "noErrorTruncation": true
		// disabling until compatible with tsgo
		// "erasableSyntaxOnly": true
	},
	"exclude": [
		"**/out",
		"**/node_modules",
		"./ark/docs",
		"**/*.scratch.ts",
		// generated programs, untyped by design
		"./ark/aot/__tests__/temp/programs",
		// its cyclic scopes have inferred types TypeScript 7 can't declare
		"./ark/aot/__tests__/declared",
		// its global classes would conflict with those of @types/node
		"./ark/repo/tsCompat/workers.d.ts",
		// run inside external benchmarks, against their sources and installs
		"./ark/repo/bench/external/moltar/cjs",
		"./ark/repo/bench/external/sb",
		"./ark/repo/bench/external/sury/cases.ts",
		// its forms import libraries from its own install
		"./ark/repo/bench/external/forms"
	]
}
