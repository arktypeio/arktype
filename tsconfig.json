{
	"extends": "./ark/util/tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"customConditions": ["ark-ts"],
		// types for attest's TS 7 backend, which imports from whichever
		// typescript is installed at runtime
		"paths": {
			"typescript/unstable/ast": [
				"./ark/attest/node_modules/typescript-7/dist/ast/index.d.ts"
			],
			"typescript/unstable/fs": [
				"./ark/attest/node_modules/typescript-7/dist/api/fs.d.ts"
			],
			"typescript/unstable/sync": [
				"./ark/attest/node_modules/typescript-7/dist/api/sync/api.d.ts"
			]
		},
		"types": ["mocha", "node"],
		// avoid prototype methods that are not available and cannot easily be transpiled
		"lib": ["ES2020"]
		// "noErrorTruncation": true
		// disabling until compatible with tsgo
		// "erasableSyntaxOnly": true
	},
	"exclude": ["**/out", "**/node_modules", "./ark/docs", "**/*.scratch.ts"]
}
